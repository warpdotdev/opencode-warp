{
  "name": "@warp-dot-dev/opencode-warp",
  "version": "0.1.7",
  "description": "Warp terminal integration for OpenCode — native notifications and more",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.0"
  },
  "files": [
    "dist",
    "tui.js"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "echo 'Add \"@warp-dot-dev/opencode-warp\" to ~/.config/opencode/cli.json under plugins.' && echo 'Then run: opencode'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "warp",
    "terminal",
    "notifications"
  ],
  "author": "Warp (https://warp.dev)",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/warpdotdev/opencode-warp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warpdotdev/opencode-warp.git"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "solid-js": "^1.9.17",
    "typescript": "^5.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "@opencode/client": "^2.0.32",
    "undici-types": "^7.18.2",
    "zod": "^4.1.8"
  },
  "bugs": {
    "url": "https://github.com/warpdotdev/opencode-warp/issues"
  }
}
