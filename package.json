{
  "name": "@warp-dot-dev/opencode-warp",
  "version": "0.2.0",
  "description": "Warp terminal integration for OpenCode - native notifications and more",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "tsc && node -e 'console.log(JSON.stringify({plugins: [process.cwd() + \"/dist\"]}, null, 2))'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "warp",
    "terminal",
    "notifications"
  ],
  "author": "Warp (https://warp.dev)",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/warpdotdev/opencode-warp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warpdotdev/opencode-warp.git"
  },
  "devDependencies": {
    "@opencode/client": "^2.2.4",
    "@opencode/plugin": "^2.2.4",
    "@types/node": "^25.5.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.4"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "directories": {
    "test": "tests"
  },
  "bugs": {
    "url": "https://github.com/warpdotdev/opencode-warp/issues"
  }
}
